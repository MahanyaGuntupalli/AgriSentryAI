[TEMPLATE]
# --- AgriSentry AI backend configuration (copy to .env and fill in) ---

# Weather: "real" uses OpenWeatherMap, "simulated" uses the built-in simulated provider.
# SIMULATED weather is clearly labeled and must never be presented as real.
WEATHER_MODE=simulated
WEATHER_API_KEY=
WEATHER_CACHE_TTL=600
DEFAULT_LAT=17.3850
DEFAULT_LON=78.4867

# Disease model: optional path to a trained model. If empty, the backend looks
# for ai/models/tomato_disease_model.h5 and otherwise uses a labeled placeholder.
DISEASE_MODEL_PATH=

# Crop-identification model (Stage 1): if empty, the backend looks for
# ai/models/crop_model.h5 with class list ai/models/crop_model_labels.txt.
# Until it is deployed, plant identification reports UNKNOWN and the
# farmer-selected crop is treated as metadata only.
CROP_MODEL_PATH=
CROP_ID_THRESHOLD=0.60
CROP_CONFLICT_THRESHOLD=0.70

# Database
AGRISENTRY_DB=agrisentry.db
