        {
            "label": "1b. Backend: install dependencies",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "1. Backend: setup environment",
